{
  "presets": {
    "appear": {
      "duration": 360,
      "easing": "cubic-bezier(.22,1,.36,1)",
      "from": {
        "opacity": 0,
        "translateY": 12,
        "scale": 0.985
      }
    },
    "spatialEnter": {
      "duration": 650,
      "easing": "cubic-bezier(.16,1,.3,1)",
      "from": {
        "opacity": 0,
        "translateZ": -24,
        "scale": 0.96
      }
    },
    "focus": {
      "duration": 220,
      "easing": "cubic-bezier(.2,.8,.2,1)",
      "from": {
        "scale": 1
      },
      "to": {
        "scale": 1.025
      }
    },
    "exit": {
      "duration": 220,
      "easing": "ease-out",
      "to": {
        "opacity": 0,
        "scale": 0.985
      }
    },
    "ambient": {
      "duration": 4000,
      "easing": "ease-in-out",
      "loop": true,
      "delta": {
        "translateY": 3
      }
    }
  },
  "reducedMotion": {
    "replaceParallaxWith": "crossFade",
    "replaceTiltWith": "none",
    "maxDuration": 220
  },
  "sharedElements": [
    "avatar",
    "heroMedia",
    "placePin",
    "eventPoster",
    "messageThread",
    "primaryAction",
    "profileHeader"
  ]
}
