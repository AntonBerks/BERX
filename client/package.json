		"esbuild": "^0.24.2",
		"playwright": "^1.49.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "^2.1.0",
		"@react-native-community/netinfo": "^11.4.1",
		"@types/react": "19.0.0",
		"react": "^19.0.0",
		"react-native": "^0.79.5",
		"react-native-svg": "^15.11.2"
	},
	"overrides": {
