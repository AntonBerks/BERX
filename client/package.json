		"verify:5d-volumetric": "node ./scripts/verify-5d-volumetric.mjs",
		"verify:5d-particles": "node ./scripts/verify-5d-particles.mjs",
		"verify:5d-quality": "node ./scripts/verify-5d-quality.mjs",
		"verify:5d-framing": "node ./scripts/verify-5d-framing.mjs",
		"verify:5d-exposure": "node ./scripts/verify-5d-exposure.mjs",
		"verify:5d-pipeline": "node ./scripts/verify-5d-pipeline.mjs",
