{
  "name": "berx-client",
  "private": true,
  "version": "0.1.0",
  "description": "BERX mobile client monorepo foundation",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:static": "bash ./scripts/verify-static.sh",
    "verify:v9": "node ./scripts/verify-v9-contracts.mjs",
    "verify:5d-runtime": "node ./scripts/verify-5d-runtime.mjs",
    "verify:5d-geometry": "node ./scripts/verify-5d-geometry.mjs",
    "generate:v9": "node ./scripts/generate-v9-scenes.mjs",
    "verify:v9:web": "node ./scripts/v9-web-probe.mjs",
    "build:spatial-web": "node ./scripts/build-spatial-web.mjs",
    "verify:5d-gpu": "node ./scripts/verify-5d-gpu.mjs",
    "verify:5d-shared-core": "node ./scripts/verify-5d-shared-core.mjs",
    "verify:5d-world": "node ./scripts/verify-5d-world.mjs",
    "verify:5d-app-shell": "node ./scripts/verify-5d-app-shell.mjs",
    "verify:5d-lighting": "node ./scripts/verify-5d-lighting.mjs",
    "verify:5d-platforms": "node ./scripts/verify-5d-platforms.mjs",
    "verify:5d": "npm run typecheck && npm run verify:static && npm run verify:5d-shared-core && npm run verify:5d-world && npm run verify:5d-runtime && npm run verify:5d-geometry && npm run verify:5d-gpu && npm run verify:5d-lighting && npm run verify:5d-platforms && npm run build:spatial-web && npm run verify:5d-app-shell && npm run verify:5d-crossrender && npm run verify:5d-native-targets && npm run verify:5d-xr && npm run verify:5d-backend && npm run verify:5d-realtime && npm run verify:5d-haptics && npm run verify:5d-transitions && npm run verify:v9 && npm run verify:v9:web && npm run verify:5d-blockers && npm run verify:5d-launch-gate",
    "verify:5d-realtime": "node ./scripts/verify-5d-realtime.mjs",
    "verify:5d-haptics": "node ./scripts/verify-5d-haptics.mjs",
    "verify:5d-transitions": "node ./scripts/verify-5d-transitions.mjs",
    "verify:5d-blockers": "node ./scripts/verify-5d-blockers.mjs",
    "verify:5d-launch-gate": "node ./scripts/verify-5d-launch-gate.mjs",
    "verify:5d-crossrender": "node ./scripts/verify-5d-crossrender.mjs",
    "generate:shaders": "node ./scripts/generate-shaders.mjs",
    "package:desktop": "node ./scripts/package-desktop.mjs",
    "verify:5d-native-targets": "node ./scripts/verify-5d-native-targets.mjs",
    "verify:5d-xr": "node ./scripts/verify-5d-xr.mjs",
    "verify:5d-backend": "node ./scripts/verify-5d-backend.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.24.2",
    "playwright": "^1.49.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@types/react": "19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.79.5",
    "react-native-svg": "^15.11.2"
  },
  "overrides": {
    "@types/react": "$@types/react"
  }
}
