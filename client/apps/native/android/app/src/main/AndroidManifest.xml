<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vulkan 1.1 is what the renderer needs; a device without it cannot
         run BERX, and saying so here is better than failing at runtime. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for BerxHaptics: VibrationEffect.createWaveform() is
         silently ignored without it, which would look like a device
         with no motor rather than a missing permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required by BerxVoice: SpeechRecognizer returns ERROR_INSUFFICIENT_PERMISSIONS
         without it, which is indistinguishable from a device that simply
         did not hear anything. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11+ package visibility: without this the TextToSpeech and
         SpeechRecognizer services are invisible to the app and both
         silently report unavailable. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:label="BERX"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">
        <activity
            android:name=".BerxActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
